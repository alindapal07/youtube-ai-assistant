# ============================================================
# YouTube AI Assistant - Backend Environment Configuration
# ============================================================

# Groq API Configuration (Required for Chat & Insights)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# HuggingFace Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,*

# Storage and Caching
FAISS_STORAGE_DIR=backend/app/storage
CACHE_TTL_HOURS=24

# Retrieval Parameters
MAX_QUESTION_LENGTH=1000
RETRIEVAL_K=4
RETRIEVAL_FETCH_K=20
RETRIEVAL_LAMBDA_MULT=0.5

